<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> | Trivia
  </title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <header>
    <nav>
      <div class="container">
        <a href="/" class="logo">Trivia</a>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <% if (user) { %>
            <li><a href="/profile">Profile</a></li>
            <li>
              <form action="/users/logout" method="POST" style="display: inline;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-link">Logout</button>
              </form>
            </li>
            <% } else { %>
              <li><a href="/login">Login</a></li>
              <li><a href="/register">Register</a></li>
              <% } %>
        </ul>
      </div>
    </nav>
  </header>

  <main class="container">
    <section class="hero">
      <h1>Trivia Home</h1>
      <p>Choose a Game Below to Get Started</p>
    </section>

    <section class="trivia-games">
      <h2>Game Selection</h2>
      <% if (user) { %>
        <a href="/create"><button class="btn">Create a new Game</button></a>
        <% } %>
          <div class="trivia-games-grid">
            <% data.forEach(game=> { %>
              <div class="trivia-game">
                <h3>
                  <%= game.title %>
                </h3>
                <p>
                  <%= game.description %>
                </p>
                <p>
                  <a href="/gamescreen/<%= game.slug %>">
                    <% if (user) { %>
                      <button class="btn">Play</button>
                      <% } %>
                  </a>
                </p>
              </div>
              <% }) %>
          </div>
    </section>

    <section class="leaderboard">
      <h2>Leaderboard</h2>
      <h3>Top 5 players with the highest all-time scores</h3>
      <ol>
        <li>Player 1</li>
        <li>Player 2</li>
        <li>Player 3</li>
        <li>Player 4</li>
        <li>Player 5</li>
      </ol>
    </section>
  </main>

  <footer>
    <div class="container">
      <p>&copy; 2025 CS346 Trivia Project. All rights reserved.</p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>

</html>