<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Trivia</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <nav>
      <div class="container">
        <a href="/" class="logo">Trivia</a>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <% if (user) { %>
            <li><a href="/profile">Profile</a></li>
          <% } else { %>
            <li><a href="/login">Login</a></li>
            <li><a href="/register">Register</a></li>
          <% } %>
        </ul>
      </div>
    </nav>
  </header>

  <main class="container">
    <section class="hero">
      <h1><%= title%></h1>
      <p>Choose the best answer below</p>
    </section>
    <section class="trivia-games">
      <h2> <%= question.question %></h2>
      <div class="trivia-games-grid">
        <div class="answers">
          <h3>Choices</h3>
          <ul>
            <li><input type="radio" name="choice" id="first" value="<%= question.choices[0] %>"> <%= question.choices[0] %> </li>
            <li><input type="radio" name="choice" id="second" value="<%= question.choices[1] %>"> <%= question.choices[1] %></li>
            <li><input type="radio" name="choice" id="third" value="<%= question.choices[2] %>"> <%= question.choices[2] %></li>
            <li><input type="radio" name="choice" id="fourth" value="<%= question.choices[3] %>"> <%= question.choices[3] %></li>
          </ul>
          <button class="btn" id="submitAnswer">Submit</button>
        </div>
      </div>
    </section>

  <footer>
    <div class="container">
      <p>&copy; 2025 CS346 Trivia Project. All rights reserved.</p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>