<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> | Trivia
  </title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <header>
    <nav>
      <div class="container">
        <a href="/" class="logo">Trivia</a>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <% if (user) { %>
            <li><a href="/profile">Profile</a></li>
            <% } else { %>
              <li><a href="/login">Login</a></li>
              <li><a href="/register">Register</a></li>
              <% } %>
        </ul>
      </div>
    </nav>
  </header>

  <main class="container">
    <section class="hero">
      <h1>
        <%= title%>
      </h1>
      <p>Choose the best answer below</p>
    </section>
    <section class="trivia-games">
      <form id="answerForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h2>
          <%= question.question %>
        </h2>
        <div class="answers">
          <h3>Choices</h3>
          <ul>
            <li>
              <input type="radio" name="selectedAnswer" value="A" required>
              <%= question.option_a %>
            </li>
            <li>
              <input type="radio" name="selectedAnswer" value="B">
              <%= question.option_b %>
            </li>
            <li>
              <input type="radio" name="selectedAnswer" value="C">
              <%= question.option_c %>
            </li>
            <li>
              <input type="radio" name="selectedAnswer" value="D">
              <%= question.option_d %>
            </li>
          </ul>
          <input type="hidden" name="question_id" value="<%= question.id %>">
          <button class="btn" id="submitAnswer">Submit</button>
        </div>
      </form>
    </section>

    <footer>
      <div class="container">
        <p>&copy; 2025 CS346 Trivia Project. All rights reserved.</p>
      </div>
    </footer>

    <script src="/js/main.js"></script>
</body>

</html>